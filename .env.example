# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота MAX (business.max.ru → бот → токен). Пусто — бот выключен, работает только веб-часть.
BOT_TOKEN=
# Username бота для кнопок мини-приложения (open_app). Пусто — возьмём из GET /me.
BOT_USERNAME=
# Адрес Bot API MAX.
MAX_API_BASE=https://platform-api2.max.ru

# Ключ DaData (подсказки и нормализация адресов). Пусто — локальный разбор, адрес помечается «не сверен с ФИАС».
DADATA_API_KEY=
# URL сервиса распознавания (POST multipart: image). Обычно пусто: в docker compose при заданном YC_API_KEY
# (см. ниже) бот сам ходит в контейнер meter-reader. Заполнять только для внешнего сервиса или запуска без Docker.
# Пусто и без ключей — демо-распознавание: значение подставляется, в сообщениях это честно помечено.
RECOGNIZER_URL=

# ФГИС «Аршин» (Росстандарт): срок поверки по заводскому номеру. live — настоящий API (нужен российский IP
# сервера, лимит 2 запроса в секунду); fixtures — демо-данные ФГИС (в сообщениях помечены); off — выключено.
ARSHIN_MODE=live
# Адрес API (тестовый стенд Росстандарта: https://fgis.gost.ru/fundmetrologytest/eapi).
ARSHIN_BASE=https://fgis.gost.ru/fundmetrology/eapi
# IP fgis.gost.ru на случай, если DNS в контейнере не резолвит хост; через запятую. Пусто — выключено.
ARSHIN_FALLBACK_IPS=212.164.138.19,212.164.138.14

# --- Распознавание показаний (контейнер meter-reader, services/meter_reader) ---
# Заданы оба ключа — распознавание включено. API-ключ сервисного аккаунта Yandex Cloud (роль ai.languageModels.user) и ID каталога.
YC_API_KEY=
YC_FOLDER_ID=
# Мультимодальная модель AI Studio и таймаут запроса к ней, секунды.
# YC_MODEL=qwen3.6-35b-a3b
# YC_TIMEOUT=15

# Демо-механизмы для жюри (команда /demo — примеры уведомлений). true/false.
DEMO_MODE=true
# ТОЛЬКО для локальной разработки мини-приложения: принимать заголовок X-Dev-User без initData.
DEV_AUTH=false
# Срок действия initData мини-приложения, секунды (24 ч).
INIT_DATA_TTL=86400
# Домены мини-приложения для CORS, через запятую (мини-приложение на GitHub Pages, API — на этом сервере).
MINIAPP_ORIGINS=https://alpha7en.github.io

# Каталог данных (SQLite и временные фото). В Docker — том ./data.
DATA_DIR=data
# Часовой пояс для сроков и уведомлений.
TZ=Europe/Moscow
# Окно подачи показаний (модель): с какого по какое число месяца.
SUBMIT_DAY_FROM=15
SUBMIT_DAY_TO=25

# Для ручной живой проверки (tools/live_smoke.py, в приложении не используется):
# MAX_TEST_USER_ID=5273381
